# Smile 思迈 · SQL 管理平台 配置文件
# 复制此文件为 config.yaml 并修改相应配置项

# HTTP 服务端口
server_port: 8080

# SQLite 数据库文件路径（首次启动自动创建并执行迁移）
sqlite_path: sql-mgr.db

# Git 仓库地址（留空则禁用归档功能，也可在页面 系统配置 → Git 配置 中设置）
git_repo_url: ""

# Git 访问令牌（留空则无认证，也可在页面中配置，将加密存储）
git_token_enc: ""

# 数据源密码加密密钥（AES-256，必须为 32 字节；生产环境务必修改！）
# 生成方式: openssl rand -base64 32
encrypt_key: "change-me-32-byte-encrypt-key!!!"

# 管理密码的 bcrypt 哈希（用于查看数据源密码时的二次验证）
# 生成方式: htpasswd -bnBC 10 "" "your-password" | tr -d ':\n' | sed 's/$2y/$2a/'
admin_pw_hash: ""
